# Top-most EditorConfig file
root = true

# Global defaults
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Kotlin / Gradle
[*.{kt,kts,gradle,java}]
indent_style = space
indent_size = 4
max_line_length = 120

# Rust
[*.rs]
indent_style = space
indent_size = 4

# C / C++ / Headers
[*.{c,cpp,h,hpp}]
indent_style = space
indent_size = 4

# YAML / JSON / XML
[*.{yml,yaml,json,xml}]
indent_style = space
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2
